N8N_HOST=automation.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://automation.example.com/
N8N_EDITOR_BASE_URL=https://automation.example.com/
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.16.1
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_WORKER_CONCURRENCY=5

POSTGRES_IMAGE=postgres:16.8-alpine
POSTGRES_DB=n8n
POSTGRES_USER=n8n

REDIS_IMAGE=redis:7.4.2-alpine
EXECUTIONS_DATA_MAX_AGE=336

PYTHON_RUNNER_TIMEOUT_SECONDS=30

N8N_API_BASE_URL=https://automation.example.com

CADDY_IMAGE=caddy:2.9.1-alpine
N8N_PUBLIC_HOSTNAME=automation.example.com
# Username for the extra Caddy login gate in front of n8n.
# The password is not stored here. Generate its hash with scripts/new-production-secrets.ps1.
CADDY_BASIC_AUTH_USER=replace_with_private_admin_user
HTTP_PORT=80
HTTPS_PORT=443
