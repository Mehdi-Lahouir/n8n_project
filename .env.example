N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_ENCRYPTION_KEY=replace-with-a-stable-random-secret-at-least-32-chars
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_WORKER_CONCURRENCY=5

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

REDIS_IMAGE=redis:7-alpine
EXECUTIONS_DATA_MAX_AGE=336

PYTHON_RUNNER_TOKEN=replace-with-a-random-runner-token
PYTHON_RUNNER_TIMEOUT_SECONDS=30

N8N_API_BASE_URL=http://localhost:5678
N8N_API_KEY=replace-with-your-n8n-api-key
